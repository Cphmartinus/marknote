{
  "name": "marknote",
  "version": "1.0.1",
  "description": "Markdown-læser og -editor i Microsoft Word-stil",
  "main": "main.js",
  "scripts": {
    "vendor": "node vendor.js",
    "postinstall": "node vendor.js",
    "start": "electron .",
    "dist": "node vendor.js && electron-builder --win portable --x64",
    "dist:installer": "node vendor.js && electron-builder --win nsis --x64"
  },
  "keywords": [],
  "author": "MarkNote contributors",
  "license": "MIT",
  "dependencies": {
    "docx": "^8.5.0",
    "dompurify": "^3.4.17",
    "katex": "^0.16.47",
    "mammoth": "^1.13.0",
    "marked": "^12.0.2",
    "turndown": "^7.2.5",
    "turndown-plugin-gfm": "^1.0.2"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "resedit": "^2.0.3"
  },
  "productName": "MarkNote",
  "private": true,
  "build": {
    "appId": "dk.marknote.app",
    "productName": "MarkNote",
    "copyright": "MarkNote",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "splash.html",
      "build/splash.bmp",
      "main.js",
      "preload.js",
      "lib/**",
      "renderer/**",
      "build/icon.png",
      "package.json",
      "node_modules/**/*",
      "!node_modules/.bin",
      "!node_modules/electron/**",
      "!node_modules/electron-builder/**",
      "!**/*.map",
      "!**/*.md",
      "!node_modules/katex/{src,contrib,dist/contrib}/**",
      "!afterPack.js"
    ],
    "asar": true,
    "compression": "normal",
    "win": {
      "target": [
        "portable"
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": false,
      "artifactName": "MarkNote-${version}-portable.exe",
      "fileAssociations": [
        {
          "ext": [
            "md",
            "markdown"
          ],
          "name": "Markdown-dokument",
          "description": "Markdown-dokument",
          "role": "Editor"
        }
      ]
    },
    "portable": {
      "splashImage": "build/splash.bmp",
      "artifactName": "MarkNote-${version}-portable.exe"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "MarkNote-Setup-${version}.exe",
      "perMachine": false
    },
    "afterPack": "./afterPack.js"
  }
}